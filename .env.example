# ============================================
# Alejandria - Environment Configuration
# Copy this file to .env and update values
# ============================================

# PostgreSQL Configuration
POSTGRES_DB=alejandria
POSTGRES_USER=alejandria
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=postgresql

# PostgreSQL Test Configuration
POSTGRES_TEST_DB=alejandria_test

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Redis Test Configuration (different database to separate environments)
REDIS_TEST_URL=redis://redis:6379/1

# Qdrant Configuration
QDRANT_URL=http://qdrant:6333
QDRANT_GRPC_URL=http://qdrant:6334
QDRANT_LOG_LEVEL=INFO

# Ollama Configuration
# For local development: http://localhost:11434
# For remote server via Tailscale: http://<tailscale-ip>:11434
# To get Tailscale IP: tailscale ip -4 on the remote server
OLLAMA_URL=http://localhost:11434

# Application Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Security (change in production!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
